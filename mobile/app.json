{
  "expo": {
    "name": "Padex",
    "slug": "padex-mobile",
    "scheme": "padex",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/appstore.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/ball-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "androidStatusBar": {
      "backgroundColor": "#0A0E1A",
      "barStyle": "light-content",
      "hidden": false,
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/5ec6a3d8-a9be-41ea-9dde-c02aff4e0a72"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.padex.ios",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "NSFaceIDUsageDescription": "Padex puede usar Face ID para proteger tu acceso y mantener segura tu sesion."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07111B"
      },
      "package": "com.padex.app",
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para que puedas subir tu foto de perfil.",
          "cameraPermission": "Necesitamos acceso a tu camara para que puedas sacar una foto de perfil.",
          "microphonePermission": "Necesitamos acceso a tu microfono para grabar video cuando uses la camara desde la app."
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
      "apiUrl": "https://apidev.insiderbookings.com",
      "eas": {
        "projectId": "5ec6a3d8-a9be-41ea-9dde-c02aff4e0a72"
      }
    }
  }
}
