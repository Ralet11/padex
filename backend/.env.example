NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://padex:replace-local-password@127.0.0.1:5432/padex_demo
JWT_SECRET=replace-with-a-long-random-local-secret
# Use only a disposable local database. Never reuse production credentials.
SEED_DEMO=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Keep external synchronization and payment maintenance off for a local demo.
DISABLE_BACKGROUND_WORKERS=true
